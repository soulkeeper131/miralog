# МираСкоп — променливи на средата
#
# В Coolify: Project → Environment Variables. Копирай нужните оттук.
# Локално: копирай този файл като .env и попълни стойностите.
#
# ─────────────────────────────────────────────────────────────────────
# ЗАДЪЛЖИТЕЛНИ ЗА ПРОДУКЦИЯ
# При ENVIRONMENT=production приложението отказва да стартира, ако някоя
# от тези е с примерната стойност от кода.
# ─────────────────────────────────────────────────────────────────────

# Включва строгите проверки. Задай точно "production" при реален деплой.
ENVIRONMENT=production

# Подписва JWT токените. Който го знае, може да се представи за администратор.
# Генерирай нов с:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Първият администраторски акаунт. Създава се само при празна база;
# смяната на паролата тук не променя вече създаден акаунт — за това
# използвай админ панела.
ADMIN_EMAIL=admin@miraskop.bg
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# ДЕМО АКАУНТ
# Тестов потребител на демо пакет, за проверка на заключените менюта.
#
# За публичен сайт: задай DEMO_EMAIL с празна стойност — акаунтът няма
# да се създава изобщо. Ако Coolify не приема празна променлива, задай
# DEMO_PASSWORD със силна парола вместо това.
# ─────────────────────────────────────────────────────────────────────
DEMO_EMAIL=
DEMO_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# ПО ЖЕЛАНИЕ
# ─────────────────────────────────────────────────────────────────────

# Път до файловете на Swiss Ephemeris. В Docker образа вече е зададен.
# SE_EPHE_PATH=/app/ephe

# Къде живее базата. По подразбиране е /app/data/persons.db, което е
# обявено като том в Dockerfile.
#
# ВАЖНО: в Coolify закачи постоянен том на /app/data. Без него всеки
# деплой стартира с празна база — губиш потребители, карти и плащания.
# DB_PATH=/app/data/persons.db

# ─────────────────────────────────────────────────────────────────────
# НЕ СЕ ЗАДАВАТ ТУК
# AI ключът, SMTP настройките и SEO се въвеждат от админ панела и се
# пазят в базата — така се сменят без рестарт на приложението.
# ─────────────────────────────────────────────────────────────────────
