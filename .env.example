# АстроКарта — променливи на средата
#
# В Coolify: Project → Environment Variables. Копирай нужните оттук.
# Локално: копирай този файл като .env и попълни стойностите.
#
# ─────────────────────────────────────────────────────────────────────
# ЗАДЪЛЖИТЕЛНИ ЗА ПРОДУКЦИЯ
# При ENVIRONMENT=production приложението отказва да стартира, ако някоя
# от тези е с примерната стойност от кода.
# ─────────────────────────────────────────────────────────────────────

# Включва строгите проверки. Задай точно "production" при реален деплой.
ENVIRONMENT=production

# Подписва JWT токените. Който го знае, може да се представи за администратор.
# Генерирай нов с:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Първият администраторски акаунт. Създава се само при празна база;
# смяната на паролата тук не променя вече създаден акаунт — за това
# използвай админ панела.
ADMIN_EMAIL=admin@astrokarta.bg
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# ДЕМО АКАУНТ (по желание)
# Тестов потребител на демо пакет, за проверка на заключените менюта.
#
# В продукция акаунтът НЕ се създава, освен ако не зададеш DEMO_PASSWORD.
# Не задавай нищо тук, ако не ти трябва — това е нормалното състояние.
#
# Ако го искаш: DEMO_PASSWORD трябва да е поне 8 знака. DEMO_EMAIL е
# по избор; по подразбиране е demo@astrokarta.bg.
# ─────────────────────────────────────────────────────────────────────
# DEMO_PASSWORD=
# DEMO_EMAIL=demo@astrokarta.bg

# ─────────────────────────────────────────────────────────────────────
# ПО ЖЕЛАНИЕ
# ─────────────────────────────────────────────────────────────────────

# Път до файловете на Swiss Ephemeris. В Docker образа вече е зададен.
# SE_EPHE_PATH=/app/ephe

# Къде живее базата. По подразбиране е /app/data/persons.db, което е
# обявено като том в Dockerfile.
#
# ВАЖНО: в Coolify закачи постоянен том на /app/data. Без него всеки
# деплой стартира с празна база — губиш потребители, карти и плащания.
# DB_PATH=/app/data/persons.db

# ─────────────────────────────────────────────────────────────────────
# STRIPE (онлайн плащания)
# Без тези ключове checkout бутоните връщат 503 и остава ръчният поток.
# Webhook endpoint: POST /api/stripe/webhook
# ─────────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=https://your.domain/settings?paid=1
# STRIPE_CANCEL_URL=https://your.domain/settings?paid=0

# ─────────────────────────────────────────────────────────────────────
# ИМЕЙЛ (SMTP)
# Могат да се въведат и от админ панела. Зададени тук, имат предимство, а
# SMTP записите в базата се изтриват при стартиране (един източник).
# ─────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=АстроКарта <no-reply@astrokarta.bg>
# SMTP_USE_TLS=1

# ─────────────────────────────────────────────────────────────────────
# СОЦИАЛЕН ВХОД (Google / Facebook)
# Могат да се въведат и от админ панела; тук имат предимство.
# Бутонът се показва само когато има и двете половини на двойката.
# ─────────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────
# AI КЛЮЧ
# Обикновено се задава от админ панела (провайдър + модел + ключ). Ако там
# няма нищо, се ползва първият зададен от тези, в този ред.
# ─────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# ДРУГИ
# ─────────────────────────────────────────────────────────────────────
# Марка по подразбиране (админ панелът има предимство).
# Админ панелът работи само на admin.<BRAND_DOMAIN>.
# BRAND_NAME=АстроКарта
# BRAND_TAGLINE=Астрология с точността на астрономията
# BRAND_DOMAIN=astrokarta.bg

# Следене на грешки. Без него нищо не се праща навън.
# SENTRY_DSN=

# Едновременни тежки заявки (AI, PDF, глас). 8 е за 512MB / 1 CPU.
# AI_THREAD_LIMIT=8

# Колко дневни копия на базата да се пазят в data/backups/.
# BACKUP_KEEP_DAYS=7

# Дневни логове (Админ → Логове чете оттук) и колко дни да се пазят.
# LOG_DIR=/app/data/logs
# LOG_KEEP_DAYS=14

# Тестови плащания без Stripe. Само за разработка — в production се игнорира.
# MOCK_PAYMENTS=1

# ─────────────────────────────────────────────────────────────────────
# НЕ СЕ ЗАДАВАТ ТУК
# SEO, GA4, имейл шаблоните, логото и юридическите данни се въвеждат от
# админ панела и се пазят в базата — така се сменят без рестарт.
# ─────────────────────────────────────────────────────────────────────
